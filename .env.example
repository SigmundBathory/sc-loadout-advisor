# Star Citizen Loadout Advisor - Environment Variables

# Database (Turso for production, local SQLite for development)
# Get your Turso credentials at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: UEX Corp API (requires API key)
NEXT_PUBLIC_UEX_API_KEY=

# Optional: Custom app URL for Vercel deployment
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
