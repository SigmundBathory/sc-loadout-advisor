# Star Citizen Loadout Advisor - Environment Variables

# Database (Turso for production, local SQLite for development)
# Get your Turso credentials at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# UEX Corp API Key (required for prices and locations)
# Get your free API key at: https://uexcorp.uk/api
# This key is used to fetch component prices and buy locations
UEX_API_KEY=

# Optional: Also support NEXT_PUBLIC for client-side usage (not recommended for production)
NEXT_PUBLIC_UEX_API_KEY=

# Optional: Custom app URL for Vercel deployment
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Required in production for POST /api/sync, /api/full-sync and /api/import
# Send it as Authorization: Bearer <token> (or X-Admin-Token).
SYNC_ADMIN_TOKEN=
